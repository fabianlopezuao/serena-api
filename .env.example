# Copia a .env y completa con lo que veas en Supabase
PORT=4000
SUPABASE_URL=https://tu-proyecto.supabase.co
# Pega AQUÍ la clave que sí te aparece (cualquiera sirve):
# Settings > API Keys > Publishable key (sb_publishable_...) o secret / service_role
SUPABASE_ANON_KEY=pega-aqui-la-clave-que-ves
# Opcional (ideal para backend): service_role o sb_secret_...
# SUPABASE_SERVICE_KEY=eyJ...
FRONTEND_URL=http://localhost:3000
